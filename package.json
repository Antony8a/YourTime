{
  "name": "yourtime",
  "version": "0.1.0",
  "private": true,
  "description": "YourTime - publish tasks, receive applications, choose who does it.",
  "scripts": {
    "dev:mobile": "pnpm --filter @yourtime/mobile start",
    "build:mobile": "pnpm --filter @yourtime/mobile build",
    "test": "pnpm --filter @yourtime/shared-utils test",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter @yourtime/mobile typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml}": "prettier --write",
    "*.go": "node scripts/gofmt-staged.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
