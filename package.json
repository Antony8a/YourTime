{
  "name": "yourtime",
  "version": "0.0.0",
  "private": true,
  "description": "YourTime - Marketplace de tiempo y servicios",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "cd apps/backend && air -c .air.toml",
    "dev:web": "cd apps/web && ng serve",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "build": "turbo run build",
    "build:backend": "cd apps/backend && go build -o bin/server ./cmd/server",
    "build:web": "cd apps/web && ng build --configuration production",
    "build:mobile": "cd apps/mobile && npx expo export --platform web",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,html,scss,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,html,scss,css,md,yaml,yml}\"",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down -v",
    "db:migrate": "cd apps/backend && go run scripts/migrate.go up",
    "db:migrate:down": "cd apps/backend && go run scripts/migrate.go down",
    "db:seed": "cd apps/backend && go run scripts/seed.go",
    "db:reset": "pnpm run db:down && pnpm run db:up && sleep 3 && pnpm run db:migrate && pnpm run db:seed",
    "generate": "turbo run generate",
    "generate:backend": "cd apps/backend && go run scripts/generate.go",
    "generate:types": "cd packages/shared-types && npm run build",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules packages/*/node_modules dist build coverage .turbo",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^18.0.0",
    "@angular-eslint/eslint-plugin": "^18.0.0",
    "@angular-eslint/eslint-plugin-template": "^18.0.0",
    "@angular-eslint/schematics": "^18.0.0",
    "@angular-eslint/template-parser": "^18.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-angular": "^6.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-rxjs": "^4.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.0.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}