# Copy to infra/docker/.env and adjust. Never commit the real file.

DB_PASSWORD=yourtime_dev

# At least 32 characters. REQUIRED outside development.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Browser origins allowed to call the API (native apps are unaffected).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# development (default) or production. Use production whenever the API can be
# reached from outside your home network.
APP_ENV=development

# Set to false once the people who should have an account do, so strangers cannot register.
REGISTRATION_OPEN=true
