# Build context is apps/backend.
FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/server ./cmd/server \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/migrate ./scripts/migrate \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/seed ./scripts/seed

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -u 1000 appuser
COPY --from=builder /out/ /usr/local/bin/
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1
# Also available in the image: `migrate` and `seed` (demo data).
ENTRYPOINT ["server"]
