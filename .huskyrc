{
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "pnpm run typecheck && pnpm run lint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,html,scss,css,md,yaml,yml}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.go": [
      "gofmt -w -s",
      "goimports -w -local github.com/yourtime/backend",
      "golangci-lint run --fix"
    ]
  }
}