{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "bin/**", ".next/**", ".expo/**"],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": [],
      "cache": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": [],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": [],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["**/*.generated.ts", "**/sqlc/**", "**/wire_gen.go"],
      "cache": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "JWT_SECRET",
    "STRIPE_SECRET_KEY",
    "MERCADOPAGO_ACCESS_TOKEN"
  ],
  "globalDependencies": [".env*"]
}